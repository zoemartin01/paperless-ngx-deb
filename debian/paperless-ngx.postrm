#!/bin/sh
set -e

case "$1" in
  purge)
    dpkg-divert --list 2>/dev/null | awk '/ by paperless-ngx$/ {print $3}' | while read -r target; do
      divert="${target}.paperless-ngx"

      if [ -e "$target" ]; then
        backup="${target}.paperless-ngx.disabled"
        if [ -e "$backup" ]; then
          backup="${target}.paperless-ngx.disabled.$(date +%s)"
        fi
        mv -f "$target" "$backup" || true
      fi

      dpkg-divert --package paperless-ngx --remove --rename --divert "$divert" "$target" || true
    done
    ;;
esac

#DEBHELPER#
exit 0

